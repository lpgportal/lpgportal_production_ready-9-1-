# ====================================================
# LPGPORTAL PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================

# APP CONFIGURATION
NODE_ENV="production"
PORT=3000
APP_URL="https://lpgportal.com"
GEMINI_API_KEY="your-gemini-3.5-flash-api-key"

# DATABASE CONFIGURATION
# PostgreSQL Connection URL (e.g. Supabase, Neon, RDS or Local)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?schema=public"

# SMS GATEWAY CONFIGURATION (Netgsm)
NETGSM_USER="your-netgsm-username"
NETGSM_PASSWORD="your-netgsm-password"
NETGSM_HEADER="LPGPORTAL"

# EMAIL GATEWAY CONFIGURATION (Resend)
RESEND_API_KEY="re_yourresendapikey"
RESEND_FROM_EMAIL="LPG PORTAL <info@lpgportal.com>"

# OBJECT STORAGE CONFIGURATION (Cloudflare R2)
R2_ACCESS_KEY="your-cloudflare-r2-access-key-id"
R2_SECRET_KEY="your-cloudflare-r2-secret-access-key"
R2_BUCKET_NAME="lpgportal-media"
R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="https://cdn.lpgportal.com"

# PAYMENT GATEWAY CONFIGURATION (PayTR)
PAYTR_MERCHANT_ID="your-paytr-merchant-id"
PAYTR_MERCHANT_KEY="your-paytr-merchant-key"
PAYTR_MERCHANT_SALT="your-paytr-merchant-salt"
